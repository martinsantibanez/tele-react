PORT=3333
HOST=localhost
KV_REST_API_READ_ONLY_TOKEN=
KV_REST_API_TOKEN=
KV_REST_API_URL=
KV_URL=

# YouTube "subscribed channels live now" — OAuth (Google Cloud project with
# YouTube Data API v3 enabled, OAuth client of type "Web application" whose
# Authorized redirect URI is <origin>/api/youtube/callback).
# Client id is public; the secret is server-only and stays out of the bundle.
NEXT_PUBLIC_YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# 32-byte key used to encrypt the refresh token stored in the session cookie.
# Generate with: openssl rand -base64 32
YOUTUBE_TOKEN_SECRET=

# Spotify "my playlists / albums / top artists" — OAuth (app created at
# developer.spotify.com/dashboard, with <origin>/api/spotify/callback added as a
# Redirect URI). Note Spotify only accepts https or the loopback literal, so in
# development register http://127.0.0.1:3333/api/spotify/callback and open the
# app on 127.0.0.1 — http://localhost:3333 is rejected. Keep PORT pinned above:
# next dev walks upward from a busy port, and a moving port breaks the match.
# Client id is public; the secret is server-only and stays out of the bundle.
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# 32-byte key used to encrypt the refresh token stored in the session cookie.
# Generate with: openssl rand -base64 32
SPOTIFY_TOKEN_SECRET=
